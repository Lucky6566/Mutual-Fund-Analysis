from pathlib import Path
import pandas as pd

raw_folder = Path("data/raw")

csv_files = sorted(raw_folder.glob("*.csv"))

for file in csv_files:
    print("=" * 60)
    print(file.name)

    df = pd.read_csv(file)

    print("\nShape:")
    print(df.shape)

    print("\nColumns:")
    print(df.columns.tolist())

    print("\nData Types:")
    print(df.dtypes)

    print("\nFirst Five Rows:")
    print(df.head())

    print("\nMissing Values:")
    print(df.isnull().sum())